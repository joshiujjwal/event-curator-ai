# Required — fill in all values before running the app

# Database (PostgreSQL 15+ with pgvector extension)
DATABASE_URL="postgresql://user:password@localhost:5432/event_curator_ai"
DATABASE_URL_TEST="postgresql://user:password@localhost:5432/event_curator_ai_test"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# OAuth — Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth — GitHub
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# OpenAI (embeddings + summarization)
OPENAI_API_KEY=""

# Eventbrite
EVENTBRITE_API_KEY=""

# Meetup
MEETUP_CLIENT_ID=""
MEETUP_CLIENT_SECRET=""

# Ticketmaster
TICKETMASTER_API_KEY=""

# Facebook Graph API (optional — for Facebook Events)
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Redis (BullMQ job queue)
REDIS_URL="redis://localhost:6379"

# App config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
INGEST_CRON_SCHEDULE="0 */4 * * *"   # Every 4 hours
DEFAULT_SEARCH_CITY="San Francisco"
DEFAULT_SEARCH_RADIUS_KM="25"
